#include <stdio.h>

int main(void) {
    float n1, n2, n3, media;

    printf("Primeira nota: ");
    scanf("%f", &n1);
    printf("Segunda nota: ");
    scanf("%f", &n2);
    printf("Terceira nota: ");
    scanf("%f", &n3);

    media = (n1 * 2.0f + n2 * 3.0f + n3 * 5.0f) / 10.0f;
    printf("Media ponderada: %.2f\n", media);
    return 0;
}
