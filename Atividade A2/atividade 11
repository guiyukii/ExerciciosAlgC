#include <stdio.h>

int main(void) {
    int horas;
    float valorhora, bruto, inss, imposto, liquido;

    printf("Horas trabalhadas: ");
    scanf("%d", &horas);
    printf("Valor por hora (R$): ");
    scanf("%f", &valorhora);

    bruto = horas * valorhora;
    inss = bruto * 0.11f;
    imposto = bruto * 0.05f;
    liquido = bruto - inss - imposto;

    printf("\nSalario bruto: R$ %.2f\n", bruto);
    printf("Desconto previdenciario (11%%): R$ %.2f\n", inss);
    printf("Imposto de renda (5%%): R$ %.2f\n", imposto);
    printf("Salario liquido: R$ %.2f\n", liquido);
    return 0;
}
