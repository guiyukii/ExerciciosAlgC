void ex26(void) {
    double massa, altura, imc;
    printf("Massa corporal (kg): ");
    scanf("%lf", &massa);
    printf("Altura (m): ");
    scanf("%lf", &altura);
 
    if (altura <= 0) {
        printf("Altura invalida.\n");
        return;
    }
 
    imc = massa / (altura * altura);
    printf("IMC = %.2f -> ", imc);
 
    if (imc < 18.5) {
        printf("Magreza.\n");
    } else if (imc < 25.0) {
        printf("Peso adequado.\n");
    } else if (imc < 30.0) {
        printf("Sobrepeso.\n");
    } else {
        printf("Obesidade.\n");
    }
}
