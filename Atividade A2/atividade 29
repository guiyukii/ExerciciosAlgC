void ex29(void) {
    double a, b, c;
    printf("Lado A: ");
    scanf("%lf", &a);
    printf("Lado B: ");
    scanf("%lf", &b);
    printf("Lado C: ");
    scanf("%lf", &c);
 
    if (a > 0 && b > 0 && c > 0 && a < b + c && b < a + c && c < a + b) {
        if (a == b && b == c) {
            printf("Triangulo EQUILATERO.\n");
        } else if (a == b || a == c || b == c) {
            printf("Triangulo ISOSCELES.\n");
        } else {
            printf("Triangulo ESCALENO.\n");
        }
    } else {
        printf("Os lados informados nao formam um triangulo.\n");
    }
}
