#include <stdio.h>

int main(void) {
    int n, divisoes = 0;

    printf("Digite um numero inteiro maior que 1: ");
    scanf("%d", &n);

    if (n <= 1) {
        printf("Entrada invalida: o numero deve ser maior que 1.\n");
        return 1;
    }

    while (n > 1) {
        n = n / 2;
        divisoes++;
    }

    printf("Quantidade de divisoes por 2: %d\n", divisoes);
    return 0;
}
