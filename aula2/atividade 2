#include <stdio.h>
 
int main() {
    float numero1, numero2, resultado;
    char operador;

    printf("Digite o primeiro numero: ");
    scanf("%f", &numero1);
    printf("Digite o segundo numero: ");
    scanf("%f", &numero2);
    printf("Qual conta você quer fazer? (+, -, , /): ");
    scanf(" %c", &operador);

    if (operador == '+') {
        resultado = numero1 + numero2;
    } else if (operador == '-') {
        resultado = numero1 - numero2;
    } else if (operador == '') {
        resultado = numero1 * numero2;
    } else if (operador == '/') {
        resultado = numero1 / numero2;
    } else {
        printf("Operador inválido!");
        return 1; 
    }
    printf("Resultado: %.2f\n", resultado);
    return 0;
}
